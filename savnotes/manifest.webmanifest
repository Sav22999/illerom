{
  "name": "SavNotes",
  "short_name": "SavNotes",
  "description": "Free, open notebooks: write by hand on squares, lines or dots, or type as in a document, on sheets of a fixed size. Part of SavOffice.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#faf6ef",
  "theme_color": "#7b5434",
  "lang": "en",
  "categories": ["productivity", "education", "utilities"],
  "icons": [
    {"src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png"},
    {"src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "file_handlers": [
    {"action": "./", "accept": {"application/vnd.savnotes.notebook+zip": [".savnot"]}}
  ],
  "launch_handler": {"client_mode": "navigate-existing"}
}
