{
  "name": "SavPodcasts",
  "short_name": "SavPodcasts",
  "description": "Free, open podcast player: podcasts from their own public feeds, found in open catalogues, with your queue and the position synced on every device. Part of SavOffice.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f4f6fa",
  "theme_color": "#3b4b63",
  "lang": "en",
  "categories": ["entertainment", "music", "news", "education"],
  "icons": [
    {"src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png"},
    {"src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "launch_handler": {"client_mode": "navigate-existing"}
}
