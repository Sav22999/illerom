# SavPodcasts
Options -Indexes
DirectoryIndex index.php

<FilesMatch "(^\.|^credentials.*\.php$|\.(md|sql|log|bak)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# PHP libraries, tools and the cache of the artwork are not reachable from the browser
RedirectMatch 404 ^/savpodcasts/(lib|tools|tests|cache)(/|$)

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # not public yet: search engines stay away (remove when SavPodcasts goes public, see README)
  Header set X-Robots-Tag "noindex, nofollow"
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Force HTTPS (the session cookie is marked Secure)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
