# OpenNewsletter is now SavNewsletters: every address of this folder moves to /savnewsletters/, with its query string.
# 308 keeps the method: the one-click unsubscribe of mail clients (POST) and the forms still work. Links in the emails
# already sent, widgets on other sites (widget.js) and the old saveriomorelli.com redirect all land in the new folder.
# Keep this folder: the emails sent before the new name point here.
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/savnewsletters/$1 [R=308,L]
</IfModule>
<IfModule !mod_rewrite.c>
  RedirectMatch 308 ^/opennewsletter/(.*)$ /savnewsletters/$1
</IfModule>
<IfModule mod_headers.c>
  Header always unset X-Frame-Options
</IfModule>
