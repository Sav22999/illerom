# SavCalendar
Options -Indexes
DirectoryIndex index.php

<FilesMatch "(^\.|^credentials.*\.php$|\.(md|sql|log|bak)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# PHP libraries and tools are not reachable from the browser
RedirectMatch 404 ^/savcalendar/(lib|tools|tests)(/|$)

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Force HTTPS (the session cookie is marked Secure; calendars that ask webcal:// over http follow it)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # The feed for other calendars: feed/<token>.ics
  RewriteRule ^feed/([a-f0-9]{32})\.ics$ feed/index.php?t=$1 [L,QSA]
</IfModule>
