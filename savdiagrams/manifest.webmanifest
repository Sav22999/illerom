{
  "name": "SavDiagrams",
  "short_name": "SavDiagrams",
  "description": "Free, open diagrams: flowcharts, org charts and mind maps. Part of SavOffice.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f4f5fb",
  "theme_color": "#4352d6",
  "lang": "en",
  "categories": ["productivity", "business", "education"],
  "icons": [
    {"src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png"},
    {"src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "file_handlers": [
    {"action": "./", "accept": {"application/vnd.savdiagrams.diagram+zip": [".savdia"], "application/vnd.jgraph.mxfile": [".drawio"]}}
  ],
  "launch_handler": {"client_mode": "navigate-existing"}
}
