{
  "name": "SavForms",
  "short_name": "SavForms",
  "description": "Free, open forms and surveys: questions of every kind, a link to share, charts of every answer, deadlines in SavCalendar. Part of SavOffice.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f8f3fa",
  "theme_color": "#86329e",
  "lang": "en",
  "categories": ["productivity", "business", "education"],
  "icons": [
    {"src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png"},
    {"src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "shortcuts": [
    {"name": "New form", "short_name": "New", "url": "./#/new"}
  ],
  "file_handlers": [
    {"action": "./", "accept": {"application/vnd.savforms.form+zip": [".savfor"]}}
  ],
  "launch_handler": {"client_mode": "navigate-existing"}
}
