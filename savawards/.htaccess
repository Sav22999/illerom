# SavAwards
Options -Indexes
DirectoryIndex index.php

<FilesMatch "(^\.|^credentials.*\.php$|\.(md|sql|log|bak)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# PHP libraries and tools are not reachable from the browser
RedirectMatch 404 ^/savawards/(lib|tools)(/|$)

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Force HTTPS (the session cookie is marked Secure)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Public certificates: c/SA-2026-K7M3-Q9TX/product-name (the name is only for people) and the badge
  RewriteRule ^c/([A-Za-z0-9-]+)(/[^/]*)?/?$ certificate.php?c=$1 [L,QSA]
  RewriteRule ^c/?$ certificate.php [L,QSA]
  RewriteRule ^badge/([A-Za-z0-9-]+)\.svg$ badge.php?c=$1 [L,QSA]
</IfModule>
