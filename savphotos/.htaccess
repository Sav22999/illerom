# SavPhotos (its API is the one of SavDrive: ../savdrive/api/?r=photos.*)
Options -Indexes
DirectoryIndex index.php

<FilesMatch "(^\.|\.(md|sql|log|bak|sh)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# tools are not reachable from the browser
RedirectMatch 404 ^/savphotos/(tools|tests)(/|$)

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Force HTTPS (the session cookie of SavDrive is marked Secure)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
