{
  "id": "/savpresentations/", "name": "SavPresentations", "short_name": "SavPresentations",
  "description": "Presentations, without the weight.",
  "start_url": "./", "scope": "./", "display": "standalone", "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#f3f6f5", "theme_color": "#0b7f72", "categories": ["productivity", "business", "education"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [{ "action": "./", "accept": { "application/vnd.savpresentations": [".savpre"], "application/vnd.openxmlformats-officedocument.presentationml.presentation": [".pptx"] } }],
  "launch_handler": { "client_mode": "focus-existing" },
  "shortcuts": [{ "name": "My presentations", "url": "./" }]
}
