{
  "name": "SavNewsletters",
  "short_name": "SavNewsletters",
  "description": "Newsletters your team writes, approves and sends together. Part of SavOffice.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f9f4f7",
  "theme_color": "#c2307a",
  "lang": "en",
  "categories": ["productivity", "business"],
  "icons": [
    {"src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png"},
    {"src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "file_handlers": [
    {"action": "./", "accept": {"application/vnd.savnewsletters.newsletter+zip": [".savnew"]}}
  ],
  "launch_handler": {"client_mode": "navigate-existing"}
}
