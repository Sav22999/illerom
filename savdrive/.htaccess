# SavDrive
Options -Indexes
DirectoryIndex index.php

<FilesMatch "(^\.|^credentials.*\.php$|\.(md|sql|log|bak)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# PHP libraries and tools are not reachable from the browser
RedirectMatch 404 ^/savdrive/(lib|tools|tests|storage)(/|$)

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Force HTTPS (the session cookie is marked Secure)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Uploads arrive in pieces of 4 MB (see CHUNK_BYTES): PHP must accept a little more
<IfModule mod_php.c>
  php_value post_max_size 16M
  php_value max_execution_time 300
</IfModule>
